from elasticsearch import Elasticsearch
from datetime import datetime, timedelta
import time

def get_min_login_diff(ecn_input):
    # Connect to Elasticsearch
    es = Elasticsearch("http://localhost:9200")  # Adjust your ES host

    # Current time and time 30 days ago (in seconds)
    now = int(time.time())
    past_30_days = now - (30 * 24 * 60 * 60)

    # Elasticsearch query
    query = {
        "size": 1000,  # Assuming fewer than 1000 logins in 30 days
        "query": {
            "bool": {
                "must": [
                    {"term": {"ecn": ecn_input}},
                    {"range": {"login_time_stamp": {"gt": past_30_days}}}
                ]
            }
        },
        "sort": [{"login_time_stamp": {"order": "asc"}}]
    }

    # Execute the query
    res = es.search(index="your-index-name", body=query)

    # Extract sorted login timestamps
    timestamps = [hit["_source"]["login_time_stamp"] for hit in res["hits"]["hits"]]

    if len(timestamps) < 2:
        return None  # Not enough data to compute differences

    # Compute differences between consecutive timestamps
    diffs = [timestamps[i+1] - timestamps[i] for i in range(len(timestamps) - 1)]

    # Return the minimum difference
    return min(diffs)

# Example usage
ecn = input("Enter ECN: ")
min_diff = get_min_login_diff(ecn)
if min_diff is not None:
    print(f"Minimum time between logins: {min_diff} seconds")
else:
    print("Not enough login data in the last 30 days.")
