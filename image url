from elasticsearch import Elasticsearch

# Index and time range
index_name = "your-index-name"
start_time = "2025-06-13T00:00:00Z"
end_time = "2025-06-14T00:00:00Z"

# Aggregation query
query = {
    "size": 0,  # don't return actual docs
    "query": {
        "range": {
            "@timestamp": {
                "gte": start_time,
                "lt": end_time
            }
        }
    },
    "aggs": {
        "unique_device_ids": {
            "terms": {
                "field": "context.device.id.keyword",  # Use `.keyword` for exact match
                "size": 10000  # Increase if many unique device IDs
            }
        }
    }
}

# Execute search
response = es.search(index=index_name, body=query)

# Parse result
