from elasticsearch import Elasticsearch
from datetime import datetime, timedelta
import dateutil.parser  # To parse ISO 8601 timestamps

def get_min_login_diff_iso_timestamps(ecn_input):
    # Connect to Elasticsearch
    es = Elasticsearch("http://localhost:9200")  # Update if needed

    # Calculate 30 days ago in ISO 8601 format
    now = datetime.utcnow()
    thirty_days_ago = now - timedelta(days=30)
    thirty_days_ago_iso = thirty_days_ago.isoformat() + "Z"  # Add 'Z' to indicate UTC

    # Elasticsearch query
    query = {
        "size": 1000,
        "query": {
            "bool": {
                "must": [
                    {"term": {"ecn": ecn_input}},
                    {"range": {
                        "login_time_stamp": {
                            "gte": thirty_days_ago_iso
                        }
                    }}
                ]
            }
        },
        "sort": [{"login_time_stamp": {"order": "asc"}}]
    }

    # Execute query
    res = es.search(index="your-index-name", body=query)

    # Parse and sort login timestamps
    timestamps = [
        dateutil.parser.isoparse(hit["_source"]["login_time_stamp"])
        for hit in res["hits"]["hits"]
    ]

    if len(timestamps) < 2:
        return None  # Not enough logins to compare

    # Compute time differences in seconds
    diffs = [
        (timestamps[i+1] - timestamps[i]).total_seconds()
        for i in range(len(timestamps) - 1)
    ]

    return min(diffs)

# Example usage
ecn = input("Enter ECN: ")
min_diff = get_min_login_diff_iso_timestamps(ecn)

if min_diff is not None:
    print(f"Minimum time between logins in the last 30 days: {min_diff} seconds")
else:
    print("Not enough login data in the last 30 days.")
