from elasticsearch import Elasticsearch
from datetime import datetime, timedelta
import dateutil.parser

def get_min_login_diff_iso_timestamps_scroll(ecn_input):
    # Connect to Elasticsearch
    es = Elasticsearch("http://localhost:9200")  # Change if needed

    # Time range: last 30 days in ISO 8601 UTC
    now = datetime.utcnow()
    thirty_days_ago = now - timedelta(days=30)
    thirty_days_ago_iso = thirty_days_ago.isoformat() + "Z"

    print(f"Querying login events since: {thirty_days_ago_iso}")

    # Initial search with scroll
    query = {
        "size": 1000,  # Smaller chunk for memory efficiency
        "query": {
            "bool": {
                "must": [
                    {"match": {"context.customer.ecn.keyword": ecn_input}},
                    {"range": {"@timestamp": {"gte": thirty_days_ago_iso}}}
                ]
            }
        },
        "sort": [{"@timestamp": {"order": "asc"}}]
    }

    # Start scroll session
    page = es.search(
        index="tachyon-dt-fas-login-events-riskeval-geoip-qa",
        body=query,
        scroll="2m"
    )

    sid = page['_scroll_id']
    scroll_size = len(page['hits']['hits'])
    timestamps = []
    total_records_checked = 0  # Count total records

    # Collect all timestamps using scroll
    while scroll_size > 0:
        for hit in page['hits']['hits']:
            ts = hit['_source'].get('@timestamp')
            if ts:
                timestamps.append(dateutil.parser.isoparse(ts))
                total_records_checked += 1

        page = es.scroll(scroll_id=sid, scroll='2m')
        sid = page['_scroll_id']
        scroll_size = len(page['hits']['hits'])

    # Done scrolling; clear scroll context
    es.clear_scroll(scroll_id=sid)

    print(f"Total login records checked: {total_records_checked}")

    if len(timestamps) < 2:
        return None

    # Compute time differences in seconds
    diffs = [
        (timestamps[i + 1] - timestamps[i]).total_seconds()
        for i in range(len(timestamps) - 1)
    ]

    return min(diffs)

# Example usage
ecn = input("Enter ECN: ").strip()
min_diff = get_min_login_diff_iso_timestamps_scroll(ecn)

if min_diff is not None:
    print(f"Minimum time between logins in the last 30 days: {min_diff} seconds")
else:
    print(" Not enough login data in the last 30 days.")
