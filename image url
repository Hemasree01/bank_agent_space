from elasticsearch import Elasticsearch
from datetime import datetime
from collections import defaultdict

# Index and scroll settings
index_name = "your-index-name"
scroll_time = "2m"
batch_size = 1000

# Define time window for June 13, 2025
start_time = "2025-06-13T00:00:00Z"
end_time = "2025-06-14T00:00:00Z"

# Base query with time filter
query = {
    "size": batch_size,
    "query": {
        "range": {
            "@timestamp": {
                "gte": start_time,
                "lt": end_time
            }
        }
    }
}

# Start scrolling
response = es.search(
    index=index_name,
    body=query,
    scroll=scroll_time
)

scroll_id = response['_scroll_id']
all_hits = response['hits']['hits']

# Scroll loop
while True:
    response = es.scroll(scroll_id=scroll_id, scroll=scroll_time)
    hits = response['hits']['hits']
    if not hits:
        break
    all_hits.extend(hits)
    scroll_id = response['_scroll_id']

# Clear scroll context
es.clear_scroll(scroll_id=scroll_id)

# Collect unique ECNs
unique_ecns = set()
for hit in all_hits:
    source = hit.get('_source', {})
    ecn = source.get("context", {}).get("customer", {}).get("ecn")
    if ecn:
        unique_ecns.add(str(ecn))

# Output results
print(f”\n Total records checked: {len(all_hits)}")
print("Unique ECNs on 2025-06-13:")
for ecn in sorted(unique_ecns):
    print(ecn)

print(f"\nTotal unique ECNs: {len(unique_ecns)}")
